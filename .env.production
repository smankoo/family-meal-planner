# Production Environment
# Uses production Supabase project

# Supabase Configuration (Production)
# These should be set via environment variables in Render dashboard
# VITE_SUPABASE_URL - Set in Render
# VITE_SUPABASE_ANON_KEY - Set in Render

# Backend API (Production)
# VITE_API_BASE_URL - Set in Render dashboard for each environment

# Google Analytics (Production)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_DEBUG=false
VITE_GA_TEST_MODE=false

# Gemini API
VITE_GEMINI_API_KEY=

# Environment
# VITE_ENVIRONMENT - Set in Render dashboard
