# Frontend Environment Variables Example
# Copy this file to .env.local for development or .env.production for production

# Supabase Configuration
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Local Auth - Google OAuth (for local Supabase Docker)
# Get these from Google Cloud Console: https://console.cloud.google.com/
# These are used by supabase/config.toml via env() substitution
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret  # pragma: allowlist secret

# OAuth Providers (optional - configure in Supabase Dashboard)
# Google OAuth is configured in Supabase Dashboard under Authentication > Providers
# No client-side keys needed - handled by Supabase Auth

# Backend API
VITE_API_BASE_URL=http://localhost:8000

# Google Analytics
VITE_GA_MEASUREMENT_ID=
VITE_GA_DEBUG=true
VITE_GA_TEST_MODE=true

# Gemini API
VITE_GEMINI_API_KEY=

# Environment
VITE_ENVIRONMENT=development
