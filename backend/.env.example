# Backend Environment Variables Example
# Copy this file to .env for development

# Supabase Configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key - needed for admin operations (e.g. account deletion)
# Get from: supabase status (local) or Supabase Dashboard > Settings > API (cloud)
# NEVER expose this key in the browser or commit it to git
SUPABASE_SERVICE_ROLE_KEY=

# Database URL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres  # pragma: allowlist secret

# API Configuration
PORT=8000
GEMINI_API_KEY=

# Debug
SQL_DEBUG=true

# Environment
ENVIRONMENT=development
